# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/.well-known/jwks.json
# Note: SUPABASE_JWT_JWKS_URL est optionnel, sera déduit de SUPABASE_URL si absent

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Application Configuration
APP_BASE_URL=https://your-app.railway.app
NODE_ENV=production
PORT=3000

# OpenAI (existant)
OPENAI_API_KEY=sk-...

# Mistral (existant)
MISTRAL_API_KEY=...

# Frontend URL (optionnel)
FRONTEND_URL=https://your-frontend.com
NEXT_PUBLIC_FRONTEND_URL=https://your-frontend.com
